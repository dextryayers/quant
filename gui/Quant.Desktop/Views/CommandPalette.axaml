<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quant.Desktop.ViewModels"
        x:Class="Quant.Desktop.Views.CommandPalette"
        x:DataType="vm:CommandPaletteViewModel"
        Title="Command Palette"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource QuantSurface1}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBox Grid.Row="0" Text="{Binding Query}" Watermark="Type command, file, or @ symbol" Padding="10,8"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}"/>
                            <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="Up Down navigate  |  Enter run  |  Esc close" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
    </Grid>
</Window>

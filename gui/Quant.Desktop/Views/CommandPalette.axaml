<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quant.Desktop.ViewModels"
        x:Class="Quant.Desktop.Views.CommandPalette"
        x:DataType="vm:CommandPaletteViewModel"
        Title="Commands"
        Width="640" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource QuantSurface1}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="14">
        <TextBox Grid.Row="0" Text="{Binding Query}" Watermark="Type a command…" Padding="12,10" FontSize="14"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}"/>
                            <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="↑↓ navigate  •  Enter run  •  Esc close" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
    </Grid>
</Window>

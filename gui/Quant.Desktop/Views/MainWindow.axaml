<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quant.Desktop.ViewModels"
        xmlns:m="using:Quant.Desktop.Models"
        xmlns:v="using:Quant.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="using:AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Quant.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Quant IDE"
        Background="{DynamicResource QuantBgBase}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top bar -->
        <Border Grid.Row="0" Padding="14,9" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Spacing="9">
                    <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource QuantAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Quant" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource QuantTextPrimary}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{DynamicResource QuantBorderSubtle}" Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource QuantTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Width="34" Height="32" Classes="ghost" Command="{Binding NewFileCommand}" ToolTip.Tip="New file">
                        <Path Data="{x:Static v:Icons.FilePlus}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button Width="34" Height="32" Classes="ghost" Command="{Binding SaveTabCommand}" ToolTip.Tip="Save">
                        <Path Data="{x:Static v:Icons.Save}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button Width="34" Height="32" Classes="ghost" Command="{Binding SetActivityCommand}" CommandParameter="Search" ToolTip.Tip="Search in workspace">
                        <Path Data="{x:Static v:Icons.Search}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button Width="34" Height="32" Classes="ghost" Command="{Binding SetBottomTabCommand}" CommandParameter="Terminal" ToolTip.Tip="Terminal">
                        <Path Data="{x:Static v:Icons.Terminal}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button Width="34" Height="32" Classes="ghost" Command="{Binding RunTaskCommand}" ToolTip.Tip="Run task">
                        <Path Data="{x:Static v:Icons.Play}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Border Width="1" Height="16" Background="{DynamicResource QuantBorderSubtle}" Margin="4,0" VerticalAlignment="Center"/>
                    <Button Padding="10,6" Classes="ghost" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Switch appearance">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{x:Static v:Icons.Moon}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" IsVisible="{Binding IsDark}"/>
                            <Path Data="{x:Static v:Icons.Sun}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" IsVisible="{Binding IsLight}"/>
                            <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Command="{Binding OpenPaletteCommand}" ToolTip.Tip="All commands (Ctrl+Shift+P)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{x:Static v:Icons.Command}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                            <TextBlock Text="Commands" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shell -->
        <Grid Grid.Row="1" ColumnDefinitions="48,300,Auto,*,400">
            <!-- Activity bar -->
            <Border Grid.Column="0" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,0,1,0" Padding="0,10">
                <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                    <Grid>
                        <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource QuantAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" IsVisible="{Binding NavExplorer}"/>
                        <Button Width="38" Height="38" HorizontalAlignment="Center" Classes="nav" Command="{Binding SetActivityCommand}" CommandParameter="Explorer" ToolTip.Tip="Files">
                            <Path Data="{x:Static v:Icons.Folder}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource QuantAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" IsVisible="{Binding NavSearch}"/>
                        <Button Width="38" Height="38" HorizontalAlignment="Center" Classes="nav" Command="{Binding SetActivityCommand}" CommandParameter="Search" ToolTip.Tip="Search">
                            <Path Data="{x:Static v:Icons.Search}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource QuantAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" IsVisible="{Binding NavGit}"/>
                        <Button Width="38" Height="38" HorizontalAlignment="Center" Classes="nav" Command="{Binding SetActivityCommand}" CommandParameter="Git" ToolTip.Tip="Source control">
                            <Path Data="{x:Static v:Icons.GitBranch}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource QuantAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" IsVisible="{Binding NavChat}"/>
                        <Button Width="38" Height="38" HorizontalAlignment="Center" Classes="nav" Command="{Binding SetActivityCommand}" CommandParameter="Chat" ToolTip.Tip="Conversations">
                            <Path Data="{x:Static v:Icons.MessageSquare}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource QuantAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" IsVisible="{Binding NavModels}"/>
                        <Button Width="38" Height="38" HorizontalAlignment="Center" Classes="nav" Command="{Binding SetActivityCommand}" CommandParameter="Models" ToolTip.Tip="Assistants">
                            <Path Data="{x:Static v:Icons.Bot}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource QuantAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" IsVisible="{Binding NavSettings}"/>
                        <Button Width="38" Height="38" HorizontalAlignment="Center" Classes="nav" Command="{Binding SetActivityCommand}" CommandParameter="Settings" ToolTip.Tip="Settings">
                            <Path Data="{x:Static v:Icons.Settings}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Side panel V0.1.0 Explorer + Search -->
            <Border Grid.Column="1" Background="{DynamicResource QuantBgBase}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,0,1,0" Padding="14" MinWidth="200" IsVisible="{Binding SideVisible}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SideTitle}" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="Hide" FontSize="11" Classes="ghost" DockPanel.Dock="Right" Command="{Binding ToggleSideCommand}"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding ShowExplorer}">
                    <TextBox Grid.Row="1" Text="{Binding ExplorerFilter}" Watermark="Filter files" Padding="8,6" Margin="0,0,0,4"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                        <Button Width="32" Height="30" Classes="ghost" Command="{Binding RequestFolderCommand}" ToolTip.Tip="Open a folder">
                            <Path Data="{x:Static v:Icons.FolderOpen}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Button Width="32" Height="30" Classes="ghost" Command="{Binding NewFileCommand}" ToolTip.Tip="New file (Ctrl+N)">
                            <Path Data="{x:Static v:Icons.FilePlus}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Button Width="32" Height="30" Classes="ghost" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder">
                            <Path Data="{x:Static v:Icons.FolderPlus}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Button Width="32" Height="30" Classes="ghost" Command="{Binding RefreshExplorerCommand}" ToolTip.Tip="Refresh">
                            <Path Data="{x:Static v:Icons.Refresh}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                        </Button>
                    </StackPanel>
                    <TreeView Grid.Row="3" Name="ExplorerTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Icon}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Width="14"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding $parent[Window].DataContext.OpenFileCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="New File" Command="{Binding $parent[Window].DataContext.NewFileCommand}"/>
                                <MenuItem Header="New Folder" Command="{Binding $parent[Window].DataContext.NewFolderCommand}"/>
                                <Separator/>
                                <MenuItem Header="Rename" Command="{Binding $parent[Window].DataContext.RenameNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Duplicate" Command="{Binding $parent[Window].DataContext.DuplicateNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Delete" Command="{Binding $parent[Window].DataContext.DeleteNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <Separator/>
                                <MenuItem Header="Copy" Command="{Binding $parent[Window].DataContext.CopyNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Cut" Command="{Binding $parent[Window].DataContext.CutNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Paste" Command="{Binding $parent[Window].DataContext.PasteNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <Separator/>
                                <MenuItem Header="Copy Path" Command="{Binding $parent[Window].DataContext.CopyPathCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Reveal in OS" Command="{Binding $parent[Window].DataContext.RevealInOSCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <Separator/>
                                <MenuItem Header="Extensions">
                                    <MenuItem Header="Echo hello here" Command="{Binding $parent[Window].DataContext.RunExtensionCommand}" CommandParameter="echo.hello"/>
                                    <MenuItem Header="List extensions" Command="{Binding $parent[Window].DataContext.ListExtensionsCommand}"/>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                    <TextBlock Grid.Row="4" Text="Right click for full actions. Delete offers 10s undo." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSearch}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SEARCH" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <TextBox Text="{Binding SearchQuery}" Watermark="Search workspace" Padding="8,6"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Regex" IsChecked="{Binding SearchRegex}" FontSize="11"/>
                                <CheckBox Content="Case" IsChecked="{Binding SearchCase}" FontSize="11"/>
                                <CheckBox Content="Word" IsChecked="{Binding SearchWord}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="primary" Command="{Binding RunSearchCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{x:Static v:Icons.Search}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                        <TextBlock Text="Search" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button FontSize="11" Classes="ghost" Command="{Binding StopSearchCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{x:Static v:Icons.X}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stop" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding SearchStatus}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding ReplaceText}" Watermark="Replace with" Padding="8,6"/>
                            <Button Content="Replace selected" FontSize="11" Command="{Binding ReplaceSelectedCommand}"/>
                            <TextBlock Text="SYMBOLS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding SymbolQuery}" Watermark="@ symbol" Padding="8,6"/>
                            <Button Content="Find symbol" FontSize="11" Command="{Binding RunSymbolSearchCommand}"/>
                            <ListBox ItemsSource="{Binding SymbolResults}" Background="Transparent" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}"/>
                                            <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" MaxHeight="320">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowModels}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ASSISTANTS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <Border Padding="12,10" CornerRadius="12" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantAccent}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding StatusModel}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                    <TextBlock Text="{Binding ModelStatus}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Stop" FontSize="11" Classes="ghost" Command="{Binding UnloadModelCommand}" ToolTip.Tip="Free up memory"/>
                                        <Button Content="Open folder" FontSize="11" Classes="ghost" Command="{Binding OpenModelsFolderCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="6">
                                <TextBlock Text="GET MORE" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                                <TextBlock Text="Drop a model file into the folder, or get one below." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap"/>
                                <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Background="Transparent" MaxHeight="220">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DisplaySize}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Classes="primary" Padding="10,5" Command="{Binding $parent[Window].DataContext.DownloadPresetCommand}" CommandParameter="{Binding}" ToolTip.Tip="Download" IsVisible="{Binding IsPreset}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Path Data="{x:Static v:Icons.Download}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Get" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding $parent[Window].DataContext.LoadModelCommand}" CommandParameter="{Binding}" ToolTip.Tip="Switch to this one" IsVisible="{Binding !IsPreset}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Path Data="{x:Static v:Icons.Check}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Use" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Padding="8,5" Classes="danger" Command="{Binding $parent[Window].DataContext.DeleteModelCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove from this device" IsVisible="{Binding CanDelete}">
                                                        <Path Data="{x:Static v:Icons.X}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantDanger}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Padding="10,8" CornerRadius="10" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" IsVisible="{Binding Downloading}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding DownloadStatus}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="6" CornerRadius="3" Foreground="{DynamicResource QuantAccent}"/>
                                        <Button Content="Stop" FontSize="11" Classes="ghost" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBox Text="{Binding DownloadRepo}" Watermark="Source, e.g. Qwen/Example-Model" Padding="8,6"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding DownloadFile}" Watermark="File name" Padding="8,6" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Classes="primary" Command="{Binding DownloadCustomCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Data="{x:Static v:Icons.Download}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                            <TextBlock Text="Get" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Use selected" FontSize="11" Classes="primary" Command="{Binding LoadSelectedModelCommand}"/>
                                <Button Content="Refresh knowledge" FontSize="11" Classes="ghost" Command="{Binding RefreshIndexCommand}" ToolTip.Tip="Relearn the workspace"/>
                            </StackPanel>
                            <TextBlock Text="PRIVACY" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBlock Text="Private by design. Everything stays on this device." FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                            <Button Content="Forget workspace" FontSize="11" Command="{Binding ClearIndexCommand}" ToolTip.Tip="Remove what was learned about this workspace"/>
                            <TextBlock Text="EXTENSIONS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="List" FontSize="11" Classes="ghost" Command="{Binding ListExtensionsCommand}"/>
                                <Button Content="MCP" FontSize="11" Classes="ghost" Command="{Binding LoadMcpCommand}"/>
                                <Button Content="Cloud" FontSize="11" Classes="ghost" Command="{Binding ToggleCloudCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding ExtensionList}" Background="Transparent" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" Width="140"/>
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Width="50"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="MCP SERVERS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <ListBox ItemsSource="{Binding McpList}" SelectedItem="{Binding SelectedMcp}" Background="Transparent" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantAccent}" Width="140"/>
                                            <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Tools" FontSize="11" Classes="ghost" Command="{Binding ListMcpToolsCommand}"/>
                                <Button Content="Dry run" FontSize="11" Classes="ghost" Command="{Binding DryRunMcpCommand}"/>
                                <Button Content="Call" FontSize="11" Command="{Binding CallMcpToolCommand}"/>
                            </StackPanel>
                            <TextBox Text="{Binding McpToolName}" Watermark="tool.name" Padding="8,6"/>
                            <TextBox Text="{Binding McpToolArgs}" Watermark="{}" Padding="8,6"/>
                            <TextBlock Text="{Binding McpTools}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap" MaxHeight="120"/>
                            <TextBlock Text="CLOUD (OPT-IN)" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding CloudModel}" Watermark="gpt-4o-mini" Padding="8,6"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowGit}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SOURCE CONTROL" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <TextBlock Text="{Binding GitBranch}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                            <TextBlock Text="{Binding GitAhead}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Command="{Binding StageGitFileCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{x:Static v:Icons.Plus}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stage" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Diff" FontSize="11" Classes="ghost" Command="{Binding ShowGitDiffCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding GitFiles}" SelectedItem="{Binding SelectedGitFile}" Background="Transparent" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource QuantWarning}" Width="30"/>
                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding CommitMessage}" Watermark="Commit message" Padding="8,6"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="primary" Command="{Binding CommitNowCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{x:Static v:Icons.Check}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                        <TextBlock Text="Commit" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Command="{Binding GenCommitMsgCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{x:Static v:Icons.Sparkles}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                        <TextBlock Text="Gen msg" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="HISTORY" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding GitLogQuery}" Watermark="Search history" Padding="8,6"/>
                            <ListBox ItemsSource="{Binding GitLogs}" Background="Transparent" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Hash}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Classes="ghost" Command="{Binding ShowPriorVersionCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{x:Static v:Icons.History}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open prior version" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSettings}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="SETTINGS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ThemeLabel}" FontSize="11" Classes="ghost" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Switch appearance"/>
                                    <TextBlock Text="Calm by default, bright when you need it." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Assistant" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                <CheckBox Content="Code suggestions" IsChecked="{Binding CompleteEnabled}" FontSize="12"/>
                                <CheckBox Content="Cloud assistant" IsChecked="{Binding CloudEnabled}" FontSize="12"/>
                                <TextBlock Text="Off means everything stays on this device." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Workspace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                <Button Content="Commands" FontSize="11" Classes="ghost" Command="{Binding OpenPaletteCommand}" HorizontalAlignment="Left"/>
                                <Button Content="Forget workspace" FontSize="11" Classes="ghost" Command="{Binding ClearIndexCommand}" HorizontalAlignment="Left" ToolTip.Tip="Remove what was learned about this workspace"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowChats}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CONVERSATIONS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <Button FontSize="11" Classes="primary" Command="{Binding NewThreadCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                    <Path Data="{x:Static v:Icons.Plus}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="New conversation" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding ThreadSearch}" Watermark="Search conversations" Padding="8,6"/>
                            <ListBox ItemsSource="{Binding ThreadView}" SelectedItem="{Binding SelectedThread}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Updated, StringFormat='{}{0:dd MMM HH:mm}'}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Padding="7,4" VerticalAlignment="Center" Classes="danger" Command="{Binding $parent[Window].DataContext.DeleteThreadCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete">
                                                <Path Data="{x:Static v:Icons.X}" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource QuantDanger}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Nothing here yet. Start a new one above." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap" IsVisible="{Binding NoThreads}"/>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Tip: right-click any file for more actions." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="5" Background="Transparent" ResizeDirection="Columns" />

            <!-- Center: tabs + breadcrumbs + editor + bottom -->
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto,*,Auto,200">
                <ListBox Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}" Background="{DynamicResource QuantSurface1}" Margin="0" Padding="8,4">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="*" FontSize="12" Foreground="{DynamicResource QuantWarning}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center"/>
                                <Button Padding="7,4" Margin="2,0,0,0" VerticalAlignment="Center" Classes="ghost" Command="{Binding $parent[Window].DataContext.CloseTabCommand}" CommandParameter="{Binding}" ToolTip.Tip="Close">
                                    <Path Data="{x:Static v:Icons.X}" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Row="1" Margin="12,6,12,2">
                    <TextBlock Text="{Binding Breadcrumbs}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Classes="ghost" Command="{Binding TogglePreviewCommand}" ToolTip.Tip="Toggle Markdown/HTML preview" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{x:Static v:Icons.Eye}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="Preview" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding ToggleCompleteCommand}" ToolTip.Tip="Toggle inline completion" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{x:Static v:Icons.Sparkles}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="Complete" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding SaveTabCommand}" ToolTip.Tip="Save" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{x:Static v:Icons.Save}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Save All" FontSize="11" Classes="ghost" Command="{Binding SaveAllTabsCommand}" Margin="0,0,6,0"/>
                        <Button Content="Close" FontSize="11" Classes="ghost" Command="{Binding CloseTabCommand}" Margin="0,0,6,0"/>
                        <Button Content="Zen" FontSize="11" Classes="ghost" Command="{Binding ToggleZenCommand}"/>
                    </WrapPanel>
                </DockPanel>
                <Border Grid.Row="2" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,1,0,1" IsVisible="{Binding HasTabs}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <DockPanel Grid.Row="0" Margin="12,10,12,6">
                            <TextBlock Text="EDITOR" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Files" FontSize="11" Classes="ghost" Command="{Binding ToggleSideCommand}" ToolTip.Tip="Show files"/>
                                <Button Content="Console" FontSize="11" Classes="ghost" Command="{Binding ToggleBottomCommand}" ToolTip.Tip="Show console"/>
                                <Button Content="Assistant" FontSize="11" Classes="ghost" Command="{Binding ToggleRightCommand}" ToolTip.Tip="Show assistant"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="12,0,12,6">
                            <TextBox Grid.Column="0" Text="{Binding FindText}" Watermark="Find in file" Padding="8,6"/>
                            <Button Grid.Column="1" Content="Next" FontSize="11" Margin="6,0,0,0" Command="{Binding FindNextCommand}"/>
                            <CheckBox Grid.Column="2" Content="Rx" IsChecked="{Binding FindRegex}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="3" Content="Aa" IsChecked="{Binding FindCase}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding FindStatus}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="2" Margin="12,0,12,6" Padding="8,6" CornerRadius="6" Background="{DynamicResource QuantSurface2}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" IsVisible="{Binding GhostVisible}">
                            <DockPanel>
                                <TextBlock Text="{Binding GhostText}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" Foreground="{DynamicResource QuantTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding GhostWhy}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                                    <Button Content="Tab" FontSize="11" Classes="primary" Padding="10,5" Command="{Binding AcceptGhostCommand}" ToolTip.Tip="Accept full suggestion"/>
                                    <Button Content="Word" FontSize="11" Classes="ghost" Command="{Binding AcceptWordCommand}" ToolTip.Tip="Accept word (Ctrl+Right)"/>
                                    <Button Content="Next" FontSize="11" Classes="ghost" Command="{Binding NextGhostCommand}" ToolTip.Tip="Next suggestion (Alt+])"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="12,0,12,6" IsVisible="{Binding HasSelection}">
                            <TextBlock Text="Selection" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                            <Button Content="Explain" FontSize="11" Command="{Binding ExplainSelectionCommand}"/>
                            <Button Content="Fix" FontSize="11" Command="{Binding FixSelectionCommand}"/>
                            <Button Content="Add to chat" FontSize="11" Command="{Binding AddSelectionToChatCommand}"/>
                        </StackPanel>
                        <ae:TextEditor Grid.Row="3" Margin="12,0,12,12"
                                       Name="Editor"
                                       IsVisible="{Binding !PreviewMode}"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code,Consolas,Monospace"
                                       FontSize="14"
                                       Background="{DynamicResource QuantEditorBg}"
                                       Foreground="{DynamicResource QuantTextPrimary}"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
                        <Border Grid.Row="3" Margin="12,0,12,12" Padding="12,8" CornerRadius="8" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" IsVisible="{Binding PreviewMode}">
                            <ScrollViewer>
                                <TextBlock Text="{Binding PreviewText}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" IsVisible="{Binding ShowWelcome}" Padding="24">
                    <StackPanel Spacing="12" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource QuantAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Welcome to Quant" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Open a file from the left, or ask the assistant anything. Your code never leaves this device." FontSize="13" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button FontSize="11" Classes="primary" Command="{Binding NewFileCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Data="{x:Static v:Icons.Plus}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="New file" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button FontSize="11" Classes="ghost" Command="{Binding OpenPaletteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Data="{x:Static v:Icons.Command}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="Commands" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button FontSize="11" Classes="ghost" Command="{Binding ToggleRightCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Data="{x:Static v:Icons.MessageSquare}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="Assistant" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <GridSplitter Grid.Row="3" Height="5" Background="Transparent" ResizeDirection="Rows" />
                <Grid Grid.Row="4" RowDefinitions="Auto,*" Background="{DynamicResource QuantSurface1}" IsVisible="{Binding BottomVisible}" MinHeight="120">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="12,8,12,4">
                        <Button Content="Problems" FontSize="12" Classes="ghost" Command="{Binding SetBottomTabCommand}" CommandParameter="Problems"/>
                        <Button Content="Output" FontSize="12" Classes="ghost" Command="{Binding SetBottomTabCommand}" CommandParameter="Output"/>
                        <Button Content="Terminal" FontSize="12" Classes="ghost" Command="{Binding SetBottomTabCommand}" CommandParameter="Terminal"/>
                        <Button Content="Tasks" FontSize="12" Classes="ghost" Command="{Binding SetBottomTabCommand}" CommandParameter="Tasks"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ShowProblemsView}">
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,6" IsVisible="{Binding ShowTerminalView}">
                        <WrapPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Terminals}" Margin="0,0,6,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" FontSize="11" Classes="ghost" Margin="0,0,4,4" Command="{Binding $parent[Window].DataContext.ActivateTerminalCommand}" CommandParameter="{Binding}" ToolTip.Tip="Switch session"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button FontSize="11" Classes="ghost" Command="{Binding NewTerminalCommand}" ToolTip.Tip="New shell here" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{x:Static v:Icons.Plus}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="PowerShell" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button FontSize="11" Classes="ghost" Command="{Binding NewTerminalCommand}" CommandParameter="cmd" ToolTip.Tip="New raw CMD here" IsVisible="{Binding IsWindows}" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{x:Static v:Icons.Plus}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                    <TextBlock Text="CMD" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Restart" FontSize="11" Classes="ghost" Command="{Binding RestartTerminalCommand}" ToolTip.Tip="Restart this shell" Margin="0,0,6,4"/>
                            <Button Content="Clear" FontSize="11" Classes="ghost" Command="{Binding ClearTerminalCommand}" Margin="0,0,6,4"/>
                            <Button Content="Kill" FontSize="11" Classes="ghost" Command="{Binding KillTerminalCommand}" Margin="0,0,6,4"/>
                            <Button Content="Attach" FontSize="11" Classes="ghost" Command="{Binding AttachTerminalOutputCommand}" ToolTip.Tip="Attach output as chat context" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock Text="Click inside and type. Ctrl+C stops, arrows and Tab work like the real thing." FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding ShowTasksView}">
                        <Button Content="Load" FontSize="11" Classes="ghost" Command="{Binding LoadTasksCommand}" Margin="0,0,6,4"/>
                        <Button FontSize="11" Classes="primary" Command="{Binding RunTaskCommand}" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{x:Static v:Icons.Play}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                <TextBlock Text="Run" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Launch" FontSize="11" Classes="ghost" Command="{Binding LoadLaunchesCommand}" Margin="0,0,6,4"/>
                        <Button Content="Start" FontSize="11" Command="{Binding StartLaunchCommand}" Margin="0,0,6,4"/>
                        <Button Content="Stop" FontSize="11" Classes="ghost" Command="{Binding StopLaunchCommand}" Margin="0,0,6,4"/>
                        <Button Content="Template" FontSize="11" Classes="ghost" Command="{Binding WriteLaunchTemplateCommand}" Margin="0,0,6,4"/>
                        <Button Content="Test" FontSize="11" Classes="ghost" Command="{Binding TestMatcherCommand}" ToolTip.Tip="Check error detection on a sample" Margin="0,0,6,4"/>
                        <Button Content="Copy output" FontSize="11" Classes="ghost" Command="{Binding CopyFailureForChatCommand}" ToolTip.Tip="Send the output to the assistant" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Padding="6" CornerRadius="8" Background="{DynamicResource QuantBgBase}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1">
                        <Grid>
                        <ScrollViewer IsVisible="{Binding ShowOutputView}" MaxHeight="140">
                            <TextBlock Text="{Binding OutputLog}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <Border Background="{DynamicResource QuantEditorBg}" CornerRadius="8" IsVisible="{Binding ShowTerminalView}">
                            <v:TerminalView Name="TermView" Session="{Binding ActiveTerminal}" MinHeight="120" />
                        </Border>
                        <ListBox ItemsSource="{Binding Tasks}" IsVisible="{Binding ShowTasksView}" Background="Transparent" MaxHeight="80">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" Width="200"/>
                                        <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox ItemsSource="{Binding Launches}" SelectedItem="{Binding SelectedLaunch}" IsVisible="{Binding ShowTasksView}" Background="Transparent" MaxHeight="80">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantAccent}" Width="200"/>
                                        <TextBlock Text="{Binding Args}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Border>
                    </Grid>
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowProblemsView}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Problems.Count}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="problems" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                            <Button Content="Copy for chat" FontSize="11" Classes="ghost" Command="{Binding CopyProblemsForChatCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="All clear. No problems found." FontSize="12" Foreground="{DynamicResource QuantTextMuted}" IsVisible="{Binding NoProblems}" Margin="2,4,0,0"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Problems}" Background="Transparent" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="{DynamicResource QuantWarning}" Width="50"/>
                                    <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Width="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Right assistant: Codex-style thread + composer -->
            <Grid Grid.Column="4" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource QuantBgBase}" IsVisible="{Binding RightVisible}">
                <DockPanel Grid.Row="0" Margin="12,10,12,6">
                    <Button Content="{Binding StatusModel}" FontSize="12" FontWeight="SemiBold" Classes="nav" DockPanel.Dock="Left" VerticalAlignment="Center" Command="{Binding SetActivityCommand}" CommandParameter="Models" ToolTip.Tip="Change assistant"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="New" FontSize="11" Classes="primary" Command="{Binding NewThreadCommand}" ToolTip.Tip="New conversation"/>
                        <Button Content="Export" FontSize="11" Classes="ghost" Command="{Binding ExportThreadCommand}" ToolTip.Tip="Save as file"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="12,0,12,6" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Ask" FontSize="11" Classes="ghost" Command="{Binding SetModeCommand}" CommandParameter="Ask"/>
                        <Button Content="Edit" FontSize="11" Classes="ghost" Command="{Binding SetModeCommand}" CommandParameter="Edit"/>
                        <Button Content="Agent" FontSize="11" Classes="ghost" Command="{Binding SetModeCommand}" CommandParameter="Agent"/>
                        <TextBlock Text="{Binding AgentStatus}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Approvals}" Background="Transparent" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,4" CornerRadius="12" Background="{DynamicResource QuantSurface2}" BorderBrush="{DynamicResource QuantWarning}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="primary" Padding="10,5" Command="{Binding $parent[Window].DataContext.ApproveCardCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Data="{x:Static v:Icons.Check}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Allow once" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost" Command="{Binding $parent[Window].DataContext.DenyCardCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Data="{x:Static v:Icons.X}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Deny" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="12,0,12,6" Spacing="6">
                    <DockPanel>
                        <TextBlock Text="{Binding TokenMeter}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChatMode}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Chips}" Background="Transparent" MaxHeight="64">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,3" CornerRadius="10" Background="{DynamicResource QuantSurface2}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Attach file" FontSize="11" Classes="ghost" Command="{Binding AddFileChipCommand}"/>
                        <Button Content="Clear" FontSize="11" Classes="ghost" Command="{Binding ClearChipsCommand}"/>
                        <Button Content="Dry run" FontSize="11" Classes="ghost" Command="{Binding DryRunCommand}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox Grid.Row="3" ItemsSource="{Binding Messages}" Background="Transparent" Margin="12,0,12,8" Padding="0" MaxWidth="760" HorizontalAlignment="Stretch">
                    <ListBox.Resources>
                        <DataTemplate x:Key="UserTpl" x:DataType="m:ChatMessage">
                            <Border Padding="12,9" Margin="48,5,0,5" CornerRadius="14"
                                    Background="{DynamicResource QuantChatUser}"
                                    HorizontalAlignment="Right" MaxWidth="520">
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource QuantTextPrimary}"/>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="AssistantTpl" x:DataType="m:ChatMessage">
                            <Border Padding="12,10" Margin="0,5" CornerRadius="12"
                                    Background="{DynamicResource QuantChatAssistant}"
                                    BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="11" LetterSpacing="1" Foreground="{DynamicResource QuantTextMuted}"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource QuantTextPrimary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="ghost" Command="{Binding $parent[Window].DataContext.CopyLastCodeCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="{x:Static v:Icons.Copy}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center"/>
                                                <TextBlock Text="Copy code" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Insert" FontSize="11" Classes="ghost" Command="{Binding $parent[Window].DataContext.InsertLastCodeCommand}"/>
                                        <Button Content="Apply" FontSize="11" Classes="primary" Padding="10,5" Command="{Binding $parent[Window].DataContext.ApplyLastCodeCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <v:ChatTemplateSelector UserTemplate="{StaticResource UserTpl}" AssistantTemplate="{StaticResource AssistantTpl}"/>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="4" RowDefinitions="Auto,Auto" Margin="12,0,12,12">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <Button Content="Stop" FontSize="11" Classes="ghost" Command="{Binding StopChatCommand}" IsEnabled="{Binding IsBusy}"/>
                        <Button Content="Undo edit" FontSize="11" Classes="ghost" Command="{Binding UndoDiffCommand}" ToolTip.Tip="Undo the last applied edit"/>
                        <TextBlock Text="Enter to send • Shift+Enter for a new line" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" Padding="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Width="36" Height="36" CornerRadius="18" Classes="ghost" Command="{Binding AttachFileCommand}" ToolTip.Tip="Attach a file" VerticalAlignment="Bottom">
                                <Path Data="{x:Static v:Icons.Paperclip}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                            </Button>
                            <TextBox Grid.Column="1" Name="Composer" Text="{Binding InputText}" Watermark="Ask anything…" Padding="10,9" Margin="6,0" MaxHeight="160" AcceptsReturn="True" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Width="36" Height="36" CornerRadius="18" Classes="primary" Command="{Binding SendCommand}" IsVisible="{Binding ShowSend}" ToolTip.Tip="Send" VerticalAlignment="Bottom">
                                <Path Data="{x:Static v:Icons.ArrowUp}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource QuantOnAccent}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                            </Button>
                            <Button Grid.Column="2" Width="36" Height="36" CornerRadius="18" Command="{Binding StopChatCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="Stop" VerticalAlignment="Bottom">
                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource QuantTextSecondary}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" DockPanel.Dock="Left">
                    <TextBlock Text="Quant 0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                    <TextBlock Text="{Binding GitBranch, FallbackValue=main}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}"/>
                    <TextBlock Text="{Binding StatusModel}" FontSize="12" Foreground="{DynamicResource QuantTextMuted}"/>
                </StackPanel>
                <TextBlock Text="Private • Runs on this device" FontSize="12" Foreground="{DynamicResource QuantTextMuted}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Toast host overlay -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,372,12" Width="340">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" Margin="0,4" CornerRadius="8" Background="{DynamicResource QuantOverlay}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,6" Classes="ghost" Command="{Binding $parent[Window].DataContext.DismissToastCommand}" CommandParameter="{Binding}">
                                <Path Data="{x:Static v:Icons.X}" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource QuantTextSecondary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

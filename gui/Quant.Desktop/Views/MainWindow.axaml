<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quant.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="using:AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Quant.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Quant IDE - AI Code (Rust engine + GGUF)"
        Background="{DynamicResource QuantBgBase}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top bar -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Spacing="8">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource QuantAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="QUANT" FontWeight="SemiBold" FontSize="13" LetterSpacing="2" Foreground="{DynamicResource QuantTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="IDE" FontSize="12" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{DynamicResource QuantBorderSubtle}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource QuantTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Theme" Padding="12,6" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle dark premium and light pro"/>
                    <Button Content="Palette" Padding="12,6" Command="{Binding OpenPaletteCommand}" ToolTip.Tip="Open command palette"/>
                    <Button Content="Check engine" Padding="12,6" Command="{Binding CheckHealthCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shell -->
        <Grid Grid.Row="1" ColumnDefinitions="48,300,*,360">
            <!-- Activity bar -->
            <Border Grid.Column="0" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,0,1,0" Padding="0,8">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <Button Content="EX" Width="36" Height="36" Command="{Binding SetActivityCommand}" CommandParameter="Explorer" ToolTip.Tip="Explorer (Ctrl+Shift+E)"/>
                    <Button Content="SE" Width="36" Height="36" Command="{Binding SetActivityCommand}" CommandParameter="Search" ToolTip.Tip="Search (Ctrl+Shift+F)"/>
                    <Button Content="GI" Width="36" Height="36" Command="{Binding SetActivityCommand}" CommandParameter="Git" ToolTip.Tip="Source control"/>
                    <Button Content="CH" Width="36" Height="36" Command="{Binding SetActivityCommand}" CommandParameter="Chat" ToolTip.Tip="Chat (Ctrl+Alt+C)"/>
                    <Button Content="MO" Width="36" Height="36" Command="{Binding SetActivityCommand}" CommandParameter="Models" ToolTip.Tip="Models"/>
                    <Button Content="ST" Width="36" Height="36" Command="{Binding SetActivityCommand}" CommandParameter="Settings" ToolTip.Tip="Settings"/>
                </StackPanel>
            </Border>

            <!-- Side panel V0.1.0 Explorer + Search -->
            <Border Grid.Column="1" Background="{DynamicResource QuantBgBase}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,0,1,0" Padding="12" IsVisible="{Binding SideVisible}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ActiveActivity}" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="Hide" FontSize="11" DockPanel.Dock="Right" Command="{Binding ToggleSideCommand}"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding ShowExplorer}">
                    <TextBox Grid.Row="1" Text="{Binding ExplorerFilter}" Watermark="Filter files" Padding="8,6" Margin="0,0,0,4"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                        <Button Content="New" FontSize="11" Command="{Binding NewFileCommand}" ToolTip.Tip="New file (Ctrl+N)"/>
                        <Button Content="Folder" FontSize="11" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder"/>
                        <Button Content="Refresh" FontSize="11" Command="{Binding RefreshExplorerCommand}"/>
                    </StackPanel>
                    <TreeView Grid.Row="3" Name="ExplorerTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Icon}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Width="14"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding $parent[Window].DataContext.OpenFileCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="New File" Command="{Binding $parent[Window].DataContext.NewFileCommand}"/>
                                <MenuItem Header="New Folder" Command="{Binding $parent[Window].DataContext.NewFolderCommand}"/>
                                <Separator/>
                                <MenuItem Header="Rename" Command="{Binding $parent[Window].DataContext.RenameNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Duplicate" Command="{Binding $parent[Window].DataContext.DuplicateNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Delete" Command="{Binding $parent[Window].DataContext.DeleteNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <Separator/>
                                <MenuItem Header="Copy" Command="{Binding $parent[Window].DataContext.CopyNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Cut" Command="{Binding $parent[Window].DataContext.CutNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Paste" Command="{Binding $parent[Window].DataContext.PasteNodeCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <Separator/>
                                <MenuItem Header="Copy Path" Command="{Binding $parent[Window].DataContext.CopyPathCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <MenuItem Header="Reveal in OS" Command="{Binding $parent[Window].DataContext.RevealInOSCommand}" CommandParameter="{Binding $parent[TreeView].SelectedItem}"/>
                                <Separator/>
                                <MenuItem Header="Extensions">
                                    <MenuItem Header="Echo hello here" Command="{Binding $parent[Window].DataContext.RunExtensionCommand}" CommandParameter="echo.hello"/>
                                    <MenuItem Header="List extensions" Command="{Binding $parent[Window].DataContext.ListExtensionsCommand}"/>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                    <TextBlock Grid.Row="4" Text="Right click for full actions. Delete offers 10s undo." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSearch}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SEARCH" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <TextBox Text="{Binding SearchQuery}" Watermark="Search workspace" Padding="8,6"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Regex" IsChecked="{Binding SearchRegex}" FontSize="11"/>
                                <CheckBox Content="Case" IsChecked="{Binding SearchCase}" FontSize="11"/>
                                <CheckBox Content="Word" IsChecked="{Binding SearchWord}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Search" FontSize="11" Command="{Binding RunSearchCommand}"/>
                                <Button Content="Stop" FontSize="11" Command="{Binding StopSearchCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SearchStatus}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding ReplaceText}" Watermark="Replace with" Padding="8,6"/>
                            <Button Content="Replace selected" FontSize="11" Command="{Binding ReplaceSelectedCommand}"/>
                            <TextBlock Text="SYMBOLS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding SymbolQuery}" Watermark="@ symbol" Padding="8,6"/>
                            <Button Content="Find symbol" FontSize="11" Command="{Binding RunSymbolSearchCommand}"/>
                            <ListBox ItemsSource="{Binding SymbolResults}" Background="Transparent" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}"/>
                                            <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" MaxHeight="320">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowModels}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="MODELS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <TextBlock Text="{Binding ModelStatus}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Refresh" FontSize="11" Command="{Binding RefreshModelsCommand}"/>
                                <Button Content="Unload" FontSize="11" Command="{Binding UnloadModelCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Background="Transparent" MaxHeight="320">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Load selected" FontSize="11" Command="{Binding LoadSelectedModelCommand}"/>
                                <Button Content="Refresh index" FontSize="11" Command="{Binding RefreshIndexCommand}"/>
                            </StackPanel>
                            <TextBlock Text="PRIVACY" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBlock Text="Local only. Index stays in ./index. No upload." FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                            <Button Content="Delete local index" FontSize="11" Command="{Binding ClearIndexCommand}"/>
                            <TextBlock Text="EXTENSIONS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="List" FontSize="11" Command="{Binding ListExtensionsCommand}"/>
                                <Button Content="MCP" FontSize="11" Command="{Binding LoadMcpCommand}"/>
                                <Button Content="Cloud" FontSize="11" Command="{Binding ToggleCloudCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding ExtensionList}" Background="Transparent" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" Width="140"/>
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Width="50"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="MCP SERVERS" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <ListBox ItemsSource="{Binding McpList}" SelectedItem="{Binding SelectedMcp}" Background="Transparent" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantAccent}" Width="140"/>
                                            <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Tools" FontSize="11" Command="{Binding ListMcpToolsCommand}"/>
                                <Button Content="Dry run" FontSize="11" Command="{Binding DryRunMcpCommand}"/>
                                <Button Content="Call" FontSize="11" Command="{Binding CallMcpToolCommand}"/>
                            </StackPanel>
                            <TextBox Text="{Binding McpToolName}" Watermark="tool.name" Padding="8,6"/>
                            <TextBox Text="{Binding McpToolArgs}" Watermark="{}" Padding="8,6"/>
                            <TextBlock Text="{Binding McpTools}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap" MaxHeight="120"/>
                            <TextBlock Text="CLOUD (OPT-IN)" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding CloudModel}" Watermark="gpt-4o-mini" Padding="8,6"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowGit}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SOURCE CONTROL" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}"/>
                            <TextBlock Text="{Binding GitBranch}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                            <TextBlock Text="{Binding GitAhead}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Refresh" FontSize="11" Command="{Binding RefreshGitCommand}"/>
                                <Button Content="Stage" FontSize="11" Command="{Binding StageGitFileCommand}"/>
                                <Button Content="Diff" FontSize="11" Command="{Binding ShowGitDiffCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding GitFiles}" SelectedItem="{Binding SelectedGitFile}" Background="Transparent" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource QuantWarning}" Width="30"/>
                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding CommitMessage}" Watermark="Commit message" Padding="8,6"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Commit" FontSize="11" Command="{Binding CommitNowCommand}"/>
                                <Button Content="Gen msg" FontSize="11" Command="{Binding GenCommitMsgCommand}"/>
                            </StackPanel>
                            <TextBlock Text="HISTORY" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding GitLogQuery}" Watermark="Search history" Padding="8,6"/>
                            <ListBox ItemsSource="{Binding GitLogs}" Background="Transparent" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Hash}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Open prior version" FontSize="11" Command="{Binding ShowPriorVersionCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Explorer: right click. Search: SE. Models: MO." FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- Center V0.1.0: tabs + breadcrumbs + editor + bottom -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,200">
                <ListBox Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}" Background="{DynamicResource QuantSurface1}" Margin="0" Padding="8,4">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}"/>
                                <TextBlock Text="*" FontSize="12" Foreground="{DynamicResource QuantWarning}" IsVisible="{Binding IsDirty}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Row="1" Margin="12,6,12,2">
                    <TextBlock Text="{Binding Breadcrumbs}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="Preview" FontSize="11" Command="{Binding TogglePreviewCommand}" ToolTip.Tip="Toggle Markdown/HTML preview"/>
                        <Button Content="Complete" FontSize="11" Command="{Binding ToggleCompleteCommand}" ToolTip.Tip="Toggle inline completion"/>
                        <Button Content="Save" FontSize="11" Command="{Binding SaveTabCommand}"/>
                        <Button Content="Save All" FontSize="11" Command="{Binding SaveAllTabsCommand}"/>
                        <Button Content="Close" FontSize="11" Command="{Binding CloseTabCommand}"/>
                        <Button Content="Zen" FontSize="11" Command="{Binding ToggleZenCommand}"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="2" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,1,0,1">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <DockPanel Grid.Row="0" Margin="12,10,12,6">
                            <TextBlock Text="EDITOR" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Side" FontSize="11" Command="{Binding ToggleSideCommand}"/>
                                <Button Content="Panel" FontSize="11" Command="{Binding ToggleBottomCommand}"/>
                                <Button Content="Assistant" FontSize="11" Command="{Binding ToggleRightCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="12,0,12,6">
                            <TextBox Grid.Column="0" Text="{Binding FindText}" Watermark="Find in file" Padding="8,6"/>
                            <Button Grid.Column="1" Content="Next" FontSize="11" Margin="6,0,0,0" Command="{Binding FindNextCommand}"/>
                            <CheckBox Grid.Column="2" Content="Rx" IsChecked="{Binding FindRegex}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="3" Content="Aa" IsChecked="{Binding FindCase}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding FindStatus}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="2" Margin="12,0,12,6" Padding="8,6" CornerRadius="6" Background="{DynamicResource QuantSurface2}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" IsVisible="{Binding GhostVisible}">
                            <DockPanel>
                                <TextBlock Text="{Binding GhostText}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" Foreground="{DynamicResource QuantTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding GhostWhy}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                                    <Button Content="Tab" FontSize="11" Command="{Binding AcceptGhostCommand}" ToolTip.Tip="Accept full suggestion"/>
                                    <Button Content="Word" FontSize="11" Command="{Binding AcceptWordCommand}" ToolTip.Tip="Accept word (Ctrl+Right)"/>
                                    <Button Content="Next" FontSize="11" Command="{Binding NextGhostCommand}" ToolTip.Tip="Next suggestion (Alt+])"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="12,0,12,6" IsVisible="{Binding HasSelection}">
                            <TextBlock Text="Selection" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                            <Button Content="Explain" FontSize="11" Command="{Binding ExplainSelectionCommand}"/>
                            <Button Content="Fix" FontSize="11" Command="{Binding FixSelectionCommand}"/>
                            <Button Content="Add to chat" FontSize="11" Command="{Binding AddSelectionToChatCommand}"/>
                        </StackPanel>
                        <ae:TextEditor Grid.Row="3" Margin="12,0,12,12"
                                       Name="Editor"
                                       IsVisible="{Binding !PreviewMode}"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code,Consolas,Monospace"
                                       FontSize="14"
                                       Background="{DynamicResource QuantEditorBg}"
                                       Foreground="{DynamicResource QuantTextPrimary}"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
                        <Border Grid.Row="3" Margin="12,0,12,12" Padding="12,8" CornerRadius="8" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" IsVisible="{Binding PreviewMode}">
                            <ScrollViewer>
                                <TextBlock Text="{Binding PreviewText}" FontSize="13" Foreground="{DynamicResource QuantTextPrimary}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" RowDefinitions="Auto,*" Background="{DynamicResource QuantSurface1}" IsVisible="{Binding BottomVisible}">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="12,8,12,4">
                        <Button Content="Problems" FontSize="12" Command="{Binding SetBottomTabCommand}" CommandParameter="Problems"/>
                        <Button Content="Output" FontSize="12" Command="{Binding SetBottomTabCommand}" CommandParameter="Output"/>
                        <Button Content="Terminal" FontSize="12" Command="{Binding SetBottomTabCommand}" CommandParameter="Terminal"/>
                        <Button Content="Tasks" FontSize="12" Command="{Binding SetBottomTabCommand}" CommandParameter="Tasks"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ShowProblemsView}">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" IsVisible="{Binding ShowTerminalView}">
                        <TextBox Text="{Binding TerminalInput}" Watermark="Type shell command, Enter to run" Width="320" Padding="8,6"/>
                        <Button Content="Run" FontSize="11" Command="{Binding SendTerminalCommand}"/>
                        <Button Content="Kill" FontSize="11" Command="{Binding KillTerminalCommand}"/>
                        <Button Content="Attach" FontSize="11" Command="{Binding AttachTerminalOutputCommand}" ToolTip.Tip="Attach output as chat context"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" IsVisible="{Binding ShowTasksView}">
                        <Button Content="Load" FontSize="11" Command="{Binding LoadTasksCommand}"/>
                        <Button Content="Run" FontSize="11" Command="{Binding RunTaskCommand}"/>
                        <Button Content="Launch" FontSize="11" Command="{Binding LoadLaunchesCommand}"/>
                        <Button Content="Start" FontSize="11" Command="{Binding StartLaunchCommand}"/>
                        <Button Content="Stop" FontSize="11" Command="{Binding StopLaunchCommand}"/>
                        <Button Content="Template" FontSize="11" Command="{Binding WriteLaunchTemplateCommand}"/>
                        <Button Content="Matcher" FontSize="11" Command="{Binding TestMatcherCommand}" ToolTip.Tip="Test problem matcher on sample"/>
                        <Button Content="Copy fail" FontSize="11" Command="{Binding CopyFailureForChatCommand}" ToolTip.Tip="Copy failure output as chat context"/>
                    </StackPanel>
                    <Border Grid.Row="1" Padding="10,8" CornerRadius="8" Background="{DynamicResource QuantBgBase}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1">
                        <Grid>
                        <ScrollViewer IsVisible="{Binding ShowOutputView}" MaxHeight="140">
                            <TextBlock Text="{Binding OutputLog}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <ScrollViewer IsVisible="{Binding ShowTerminalView}" MaxHeight="140">
                            <TextBlock Text="{Binding TerminalOutput}" FontFamily="Cascadia Code,Consolas,Monospace" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <ListBox ItemsSource="{Binding Tasks}" IsVisible="{Binding ShowTasksView}" Background="Transparent" MaxHeight="80">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" Width="200"/>
                                        <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox ItemsSource="{Binding Launches}" SelectedItem="{Binding SelectedLaunch}" IsVisible="{Binding ShowTasksView}" Background="Transparent" MaxHeight="80">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource QuantAccent}" Width="200"/>
                                        <TextBlock Text="{Binding Args}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Border>
                    </Grid>
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowProblemsView}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Problems.Count}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="problems" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                            <Button Content="Copy for chat" FontSize="11" Command="{Binding CopyProblemsForChatCommand}"/>
                        </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Problems}" Background="Transparent" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="{DynamicResource QuantWarning}" Width="50"/>
                                    <TextBlock Text="{Binding File}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" Width="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource QuantTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Right assistant V0.1.0 threads + chips + approvals + actions -->
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource QuantBgBase}" IsVisible="{Binding RightVisible}">
                <DockPanel Grid.Row="0" Margin="12,10,12,6">
                    <TextBlock Text="ASSISTANT" FontSize="11" LetterSpacing="1.5" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="New" FontSize="11" Command="{Binding NewThreadCommand}"/>
                        <Button Content="Export" FontSize="11" Command="{Binding ExportThreadCommand}"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="12,0,12,6" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Ask" FontSize="11" Command="{Binding SetModeCommand}" CommandParameter="Ask"/>
                        <Button Content="Edit" FontSize="11" Command="{Binding SetModeCommand}" CommandParameter="Edit"/>
                        <Button Content="Agent" FontSize="11" Command="{Binding SetModeCommand}" CommandParameter="Agent"/>
                        <TextBlock Text="{Binding AgentStatus}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Approvals}" Background="Transparent" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,4" CornerRadius="8" Background="{DynamicResource QuantSurface2}" BorderBrush="{DynamicResource QuantWarning}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Tool}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Allow once" FontSize="11" Command="{Binding $parent[Window].DataContext.ApproveCardCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="Deny" FontSize="11" Command="{Binding $parent[Window].DataContext.DenyCardCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="12,0,12,6" Spacing="6">
                    <DockPanel>
                        <TextBlock Text="{Binding TokenMeter}" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChatMode}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Chips}" Background="Transparent" MaxHeight="64">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,3" CornerRadius="10" Background="{DynamicResource QuantSurface2}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource QuantTextSecondary}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Attach file" FontSize="11" Command="{Binding AddFileChipCommand}"/>
                        <Button Content="Clear" FontSize="11" Command="{Binding ClearChipsCommand}"/>
                        <Button Content="Dry run" FontSize="11" Command="{Binding DryRunCommand}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox Grid.Row="3" ItemsSource="{Binding Messages}" Background="Transparent" Margin="12,0,12,8" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,4" CornerRadius="8"
                                    Background="{DynamicResource QuantChatAssistant}"
                                    BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="11" LetterSpacing="1" Foreground="{DynamicResource QuantTextMuted}"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource QuantTextPrimary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Copy code" FontSize="11" Command="{Binding $parent[Window].DataContext.CopyLastCodeCommand}"/>
                                        <Button Content="Insert" FontSize="11" Command="{Binding $parent[Window].DataContext.InsertLastCodeCommand}"/>
                                        <Button Content="Apply" FontSize="11" Command="{Binding $parent[Window].DataContext.ApplyLastCodeCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="4" RowDefinitions="Auto,Auto" Margin="12,0,12,12">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                        <Button Content="Send" FontSize="11" Command="{Binding SendCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="Agent" FontSize="11" Command="{Binding RunAgentCommand}"/>
                        <Button Content="Stop" FontSize="11" Command="{Binding StopChatCommand}" IsEnabled="{Binding IsBusy}"/>
                        <Button Content="Undo apply" FontSize="11" Command="{Binding UndoDiffCommand}"/>
                        <TextBlock Text="/explain /fix /tests /docs" FontSize="11" Foreground="{DynamicResource QuantTextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding InputText}" Watermark="Ask about code, or type / for commands" Padding="10,8"/>
                    <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Padding="16,8" Command="{Binding SendCommand}" IsEnabled="{Binding !IsBusy}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar V0.1.0 -->
        <Border Grid.Row="2" Padding="12,7" Background="{DynamicResource QuantSurface1}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" DockPanel.Dock="Left">
                    <TextBlock Text="V0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                    <TextBlock Text="main" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}"/>
                    <TextBlock Text="{Binding BottomTab}" FontSize="12" Foreground="{DynamicResource QuantTextMuted}"/>
                </StackPanel>
                <TextBlock Text="Rust engine localhost  |  mmap GGUF Q4  |  Avalonia cross-platform" FontSize="12" Foreground="{DynamicResource QuantTextMuted}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Toast host overlay -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,372,12" Width="340">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" Margin="0,4" CornerRadius="8" Background="{DynamicResource QuantOverlay}" BorderBrush="{DynamicResource QuantBorderSubtle}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource QuantTextPrimary}"/>
                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource QuantTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="X" Margin="8,0,0,0" Padding="8,4" Command="{Binding $parent[Window].DataContext.DismissToastCommand}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quant.Desktop.App"
             xmlns:local="using:Quant.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Button system: calm secondary base, clear primary, quiet ghost -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource QuantSurface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource QuantBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantTextPrimary}"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource QuantBorderStrong}"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource QuantOverlay}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource QuantAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource QuantAccentHover}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantOnAccent}"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource QuantAccent}"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantTextSecondary}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource QuantSurface2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantTextPrimary}"/>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantTextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource QuantSurface2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantTextPrimary}"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource QuantDanger}"/>
            <Setter Property="Foreground" Value="{DynamicResource QuantDanger}"/>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource QuantDanger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource QuantDanger}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.danger:pointerover Path">
            <Setter Property="Stroke" Value="#FFFFFF"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource QuantAccent}"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource QuantAccentSoft}"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- Quant modern premium tokens: warm charcoal, single iris accent, calm borders -->
        <SolidColorBrush x:Key="QuantBgBase">#101014</SolidColorBrush>
        <SolidColorBrush x:Key="QuantSurface1">#17171D</SolidColorBrush>
        <SolidColorBrush x:Key="QuantSurface2">#1F1F27</SolidColorBrush>
        <SolidColorBrush x:Key="QuantOverlay">#26262F</SolidColorBrush>
        <SolidColorBrush x:Key="QuantBorderSubtle">#2B2B34</SolidColorBrush>
        <SolidColorBrush x:Key="QuantBorderStrong">#3D3D49</SolidColorBrush>
        <SolidColorBrush x:Key="QuantTextPrimary">#EFEFF2</SolidColorBrush>
        <SolidColorBrush x:Key="QuantTextSecondary">#A7A7B3</SolidColorBrush>
        <SolidColorBrush x:Key="QuantTextMuted">#71717C</SolidColorBrush>
        <SolidColorBrush x:Key="QuantAccent">#8FA2FF</SolidColorBrush>
        <SolidColorBrush x:Key="QuantAccentHover">#A3B2FF</SolidColorBrush>
        <SolidColorBrush x:Key="QuantAccentSoft">#262C4E</SolidColorBrush>
        <SolidColorBrush x:Key="QuantOnAccent">#101014</SolidColorBrush>
        <SolidColorBrush x:Key="QuantSuccess">#43C488</SolidColorBrush>
        <SolidColorBrush x:Key="QuantWarning">#D9A648</SolidColorBrush>
        <SolidColorBrush x:Key="QuantDanger">#E5484D</SolidColorBrush>
        <SolidColorBrush x:Key="QuantEditorBg">#101014</SolidColorBrush>
        <SolidColorBrush x:Key="QuantChatUser">#232A45</SolidColorBrush>
        <SolidColorBrush x:Key="QuantChatAssistant">#17171D</SolidColorBrush>
        <x:Double x:Key="QuantRadiusS">8</x:Double>
        <x:Double x:Key="QuantRadiusM">12</x:Double>
        <x:Double x:Key="QuantRadiusL">16</x:Double>
    </Application.Resources>
</Application>